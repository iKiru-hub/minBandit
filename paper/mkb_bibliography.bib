  keywords = {Amygdala,Cingulate cortex,Consciousness,Depression,Emotion,Emotions,Gyrus Cinguli,Human orbitofrontal cortex,Humans,Memory,Mind-brain problem,Motivation,Prefrontal Cortex,Reward,Ventromedial prefrontal cortex,Welfare},
