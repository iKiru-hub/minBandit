@article{blackmanTargetcellspecificShorttermPlasticity2013,
  title = {Target-Cell-Specific Short-Term Plasticity in Local Circuits},
  author = {Blackman, Arne V. and Abrahamsson, Therese and Costa, Rui Ponte and Lalanne, Txomin and Sjöström, P. Jesper},
  date = {2013-12-06},
  journaltitle = {Frontiers in Synaptic Neuroscience},
