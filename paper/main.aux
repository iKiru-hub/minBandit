\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textsc  {Table of performance} — \textit  {From top to bottom: results for MAB-P, MAB-D, MAB-$\sin $, and MAB-$\sin $P, for different numbers of arms $K$. Each cell reports the average regret, the stars represent the level of significance of the difference with respect to the NSA model, calculated as a Welch's independent two-sample t-test with Bonferroni correction on multiple comparisons. Values in bold indicate either the models meaningfully better then the NSA, or when the latter is better than all others. The results were obtained computed over 2 trials of 2000 rounds each, averaged over 64 simulations.}}}{14}{table.caption.5}\protected@file@percent }
\newlabel{tab:results}{{1}{14}{\textsc {Table of performance} — \textit {From top to bottom: results for MAB-P, MAB-D, MAB-$\sin $, and MAB-$\sin $P, for different numbers of arms $K$. Each cell reports the average regret, the stars represent the level of significance of the difference with respect to the NSA model, calculated as a Welch's independent two-sample t-test with Bonferroni correction on multiple comparisons. Values in bold indicate either the models meaningfully better then the NSA, or when the latter is better than all others. The results were obtained computed over 2 trials of 2000 rounds each, averaged over 64 simulations.}}{table.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textsc  {Decision-making dynamics for different models} - \textbf  {a}: \textit  {Each plot display the results from one model. The raster plots (black dots) show the arms selected at each round. The red lines represent the entropy level, calculated from the distribution of selections over the preceeding 20 rounds, smoothed with a 30-steps moving average. In the plot titles, the total reward and average entropy ($H$) over all trials are also reported.} - \textbf  {b}: \textit  {series of distributions of arm probabilities ($K=200$) with increasing levels of entropy. Subplot titles report the difference $\Delta H$ with respect to a reference uniform distribution with same mean, representing the limit of the distribution series with maximal entropy.} - \textbf  {c}: \textit  {the top sub-plot displays the average reward $\langle R\rangle $ for one trial obtained by each model for increasing levels of distribution entropy in the reward distribution. The bottom sub-plot shows the average entropy of the selections $\langle H_{s}\rangle $ for the same trial. The simulation used a stationary piecewise environment with $K=200$, $2000$ rounds, and averaged over 40 repetitions. }}}{15}{figure.caption.6}\protected@file@percent }
\newlabel{fig:entropy_fig1}{{4}{15}{\textsc {Decision-making dynamics for different models} - \textbf {a}: \textit {Each plot display the results from one model. The raster plots (black dots) show the arms selected at each round. The red lines represent the entropy level, calculated from the distribution of selections over the preceeding 20 rounds, smoothed with a 30-steps moving average. In the plot titles, the total reward and average entropy ($H$) over all trials are also reported.} - \textbf {b}: \textit {series of distributions of arm probabilities ($K=200$) with increasing levels of entropy. Subplot titles report the difference $\Delta H$ with respect to a reference uniform distribution with same mean, representing the limit of the distribution series with maximal entropy.} - \textbf {c}: \textit {the top sub-plot displays the average reward $\langle R\rangle $ for one trial obtained by each model for increasing levels of distribution entropy in the reward distribution. The bottom sub-plot shows the average entropy of the selections $\langle H_{s}\rangle $ for the same trial. The simulation used a stationary piecewise environment with $K=200$, $2000$ rounds, and averaged over 40 repetitions. }}{figure.caption.6}{}}
